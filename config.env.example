# Copy this file, rename it to 'config.env', and fill in your specific paths.
# IMPORTANT: Node.js does not expand the tilde character (~). 
# Always use full absolute paths (e.g., /home/username/...) instead of ~/.

# The executable to launch (e.g., path to the game or a terminal command)
GAME_EXECUTABLE="devilutionx"

# The specific save file you want to backup
SOURCE_PATH="/home/username/.local/share/diasurgical/devilution/single_0.sv"

# The directory where the backups should be stored
BACKUP_DIR="/home/username/Games/Diablo/saves-backup"

# Backup interval in milliseconds (e.g., 180000 = 3 minutes)
BACKUP_INTERVAL_MS=180000

# Maximum number of backups to keep before deleting the oldest ones
MAX_BACKUPS=20
